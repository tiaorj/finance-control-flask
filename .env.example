# Aplicação
APP_URL=https://financeiro.directti.dev.br
FLASK_SECRET_KEY=gere_uma_chave_aleatoria_forte
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_TESTING=false

# SQL Server
DB_SERVER=seu_servidor_sql_server
DB_DATABASE=seu_banco
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_BACKEND=pyodbc

# E-mail (opcional para recursos que enviam mensagens)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu_usuario_smtp
MAIL_PASSWORD=sua_senha_smtp
MAIL_DEFAULT_SENDER=financeiro@example.com

# Sessão
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Tarefas agendadas: habilitar em apenas um processo
ENABLE_SCHEDULER=false
